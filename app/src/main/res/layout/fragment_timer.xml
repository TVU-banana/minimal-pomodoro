<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_40">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/timer_eyebrow"
            android:textAppearance="@style/Clock.Eyebrow" />

        <TextView
            android:id="@+id/timer_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:fontFamily="serif"
            android:letterSpacing="-0.02"
            android:text="@string/timer_default_task"
            android:textColor="@color/clock_on_surface"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/timer_stage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:text="@string/timer_stage_idle"
            android:textColor="@color/clock_primary"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/timer_renderer_host"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="@dimen/space_24"
            android:background="@drawable/bg_timer_canvas"
            android:padding="@dimen/space_8" />

        <LinearLayout
            android:id="@+id/timer_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/timer_configure"
                android:textColor="@color/clock_on_surface"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:labelFor="@id/task_name_input"
                android:text="@string/task_name"
                android:textAppearance="@style/Clock.FieldLabel" />

            <EditText
                android:id="@+id/task_name_input"
                style="@style/Clock.Input"
                android:layout_marginTop="6dp"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="80"
                android:text="@string/timer_default_task" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:labelFor="@id/total_minutes_input"
                android:text="@string/timer_total_minutes"
                android:textAppearance="@style/Clock.FieldLabel" />

            <EditText
                android:id="@+id/total_minutes_input"
                style="@style/Clock.Input"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="4"
                android:text="@string/default_total_minutes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:labelFor="@id/warmup_minutes_input"
                android:text="@string/timer_warmup_minutes"
                android:textAppearance="@style/Clock.FieldLabel" />

            <EditText
                android:id="@+id/warmup_minutes_input"
                style="@style/Clock.Input"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:text="@string/default_warmup_minutes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:labelFor="@id/timer_style_input"
                android:text="@string/timer_style"
                android:textAppearance="@style/Clock.FieldLabel" />

            <Spinner
                android:id="@+id/timer_style_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:entries="@array/timer_styles"
                android:paddingHorizontal="@dimen/space_12"
                android:popupBackground="@color/clock_surface_raised" />

            <Button
                android:id="@+id/choose_background"
                style="@style/Clock.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/choose_background" />

            <TextView
                android:id="@+id/timer_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/clock_danger"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/timer_start"
                style="@style/Clock.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_20"
                android:text="@string/timer_start" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timer_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/timer_pause_resume"
                style="@style/Clock.PrimaryButton"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/timer_pause"
                tools:ignore="ButtonStyle" />

            <Button
                android:id="@+id/timer_abort"
                style="@style/Clock.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/timer_abort"
                android:textColor="@color/clock_danger"
                tools:ignore="ButtonStyle" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:background="@drawable/bg_note"
            android:lineSpacingExtra="3dp"
            android:padding="@dimen/space_16"
            android:text="@string/timer_semantics_note"
            android:textColor="@color/clock_on_surface"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
