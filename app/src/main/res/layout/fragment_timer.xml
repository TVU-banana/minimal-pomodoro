<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen countdown canvas. Visible only while the timer is active. -->
    <FrameLayout
        android:id="@+id/timer_renderer_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/clock_background" />

    <!-- Configuration surface. Covers the renderer when the timer is idle or terminal. -->
    <ScrollView
        android:id="@+id/timer_setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/clock_background"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_24"
            android:paddingBottom="@dimen/space_80">

            <LinearLayout
                android:id="@+id/tag_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/timer_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/clock_danger"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- Minimal control bar docked at the bottom while the timer is active. -->
    <LinearLayout
        android:id="@+id/timer_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/space_24"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/timer_pause_resume"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_tag_start"
            android:src="@drawable/ic_play_white"
            android:scaleType="center"
            android:layout_marginEnd="24dp"
            android:contentDescription="@string/timer_pause"
            tools:ignore="ButtonStyle" />

        <ImageButton
            android:id="@+id/timer_abort"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_tag_start"
            android:src="@drawable/ic_stop_white"
            android:scaleType="center"
            android:contentDescription="@string/timer_abort"
            tools:ignore="ButtonStyle" />
    </LinearLayout>

    <!-- Floating action button for adding new tags -->
    <ImageButton
        android:id="@+id/add_tag"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_gutter"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_add_circle"
        android:src="@drawable/ic_add"
        android:scaleType="center"
        android:elevation="6dp"
        android:stateListAnimator="@null"
        android:contentDescription="@string/tag_add"
        android:visibility="visible" />
</FrameLayout>
