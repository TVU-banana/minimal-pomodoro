<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clock_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_16"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:id="@+id/today_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:contentDescription="@string/today_back_accessibility"
            android:drawableStart="@drawable/ic_chevron_left"
            android:drawablePadding="8dp"
            android:drawableTint="@color/clock_on_surface"
            android:text="@string/today_back_title"
            android:textAppearance="@style/Clock.ScreenTitle"
            android:textSize="26sp" />

        <LinearLayout
            android:id="@+id/today_tag_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
