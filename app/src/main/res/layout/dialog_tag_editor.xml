<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_24"
    android:paddingTop="@dimen/space_16"
    android:paddingBottom="@dimen/space_8">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/tag_name_input"
        android:text="@string/tag_name"
        android:textAppearance="@style/Clock.FieldLabel" />

    <EditText
        android:id="@+id/tag_name_input"
        style="@style/Clock.Input"
        android:layout_marginTop="8dp"
        android:hint="@string/tag_name_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="20" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:text="@string/tag_color"
        android:textAppearance="@style/Clock.FieldLabel" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:id="@+id/color_swatches_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <Button
        android:id="@+id/add_color_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/tag_color_add_symbol"
        android:contentDescription="@string/tag_color_add_accessibility"
        android:textSize="24sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/tag_color_hex"
        android:textAppearance="@style/Clock.FieldLabel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/hex_input"
            style="@style/Clock.Input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:hint="#RRGGBB"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:maxLength="7" />

        <View
            android:id="@+id/color_preview"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/space_12" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:labelFor="@id/tag_daily_goal_input"
        android:text="@string/tag_daily_goal"
        android:textAppearance="@style/Clock.FieldLabel" />

    <EditText
        android:id="@+id/tag_daily_goal_input"
        style="@style/Clock.Input"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:hint="@string/tag_daily_goal_hint"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="4" />
</LinearLayout>
</ScrollView>
