<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.akira.clock.ui.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav">

        <LinearLayout
            android:id="@+id/bottom_nav_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="5dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/nav_timer"
                style="@style/Clock.BottomNavItem"
                android:contentDescription="@string/nav_timer">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="4dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_timer"
                    app:tint="@color/nav_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:text="@string/nav_timer"
                    android:textColor="@color/nav_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_habits"
                style="@style/Clock.BottomNavItem"
                android:contentDescription="@string/nav_habits">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="4dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_habits"
                    app:tint="@color/nav_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:text="@string/nav_habits"
                    android:textColor="@color/nav_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_reports"
                style="@style/Clock.BottomNavItem"
                android:contentDescription="@string/nav_reports">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="4dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_reports"
                    app:tint="@color/nav_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:text="@string/nav_reports"
                    android:textColor="@color/nav_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_settings"
                style="@style/Clock.BottomNavItem"
                android:contentDescription="@string/nav_settings">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="4dp"
                    android:duplicateParentState="true"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="@color/nav_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:letterSpacing="0"
                    android:text="@string/nav_settings"
                    android:textColor="@color/nav_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.akira.clock.ui.BottomNavigationView>
</LinearLayout>
