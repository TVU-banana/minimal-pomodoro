<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_24">

    <RadioGroup
        android:id="@+id/report_period"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_24"
        android:background="@drawable/bg_input"
        android:orientation="horizontal"
        android:padding="3dp">

        <RadioButton
            android:id="@+id/report_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_option"
            android:button="@null"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/report_all"
            android:textColor="@color/segment_text"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/report_year"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_option"
            android:button="@null"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/report_year"
            android:textColor="@color/segment_text"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/report_month"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_option"
            android:button="@null"
            android:checked="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/report_month"
            android:textColor="@color/segment_text"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/report_week"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_option"
            android:button="@null"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/report_week"
            android:textColor="@color/segment_text"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/report_day"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_option"
            android:button="@null"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/report_day"
            android:textColor="@color/segment_text"
            android:textSize="13sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/report_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/clock_on_surface"
        android:textSize="16sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/report_export_poster"
        style="@style/Clock.SecondaryButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/report_export_poster"
        android:visibility="gone" />

    <TextView
        android:id="@+id/report_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:background="@drawable/bg_note"
        android:gravity="start"
        android:lineSpacingExtra="3dp"
        android:padding="@dimen/space_20"
        android:text="@string/report_empty"
        android:textColor="@color/clock_on_surface"
        android:textSize="15sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/report_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24" />
</LinearLayout>
