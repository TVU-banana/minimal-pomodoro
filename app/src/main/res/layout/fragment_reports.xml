<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_24">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reports_eyebrow"
        android:textAppearance="@style/Clock.Eyebrow" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/reports_title"
        android:textAppearance="@style/Clock.ScreenTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:lineSpacingExtra="3dp"
        android:text="@string/reports_subtitle"
        android:textColor="@color/clock_on_surface_muted"
        android:textSize="15sp" />

    <RadioGroup
        android:id="@+id/report_period"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_24"
        android:background="@drawable/bg_input"
        android:orientation="horizontal"
        android:padding="3dp">

        <RadioButton
            android:id="@+id/report_month"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_option"
            android:button="@null"
            android:checked="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/report_month"
            android:textColor="@color/segment_text"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/report_quarter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_option"
            android:button="@null"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/report_quarter"
            android:textColor="@color/segment_text"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/report_year"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_option"
            android:button="@null"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/report_year"
            android:textColor="@color/segment_text"
            android:textSize="14sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/report_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_40"
        android:background="@drawable/bg_note"
        android:gravity="start"
        android:lineSpacingExtra="3dp"
        android:padding="@dimen/space_20"
        android:text="@string/report_empty"
        android:textColor="@color/clock_on_surface"
        android:textSize="15sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/report_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_24"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_24" />
</LinearLayout>
