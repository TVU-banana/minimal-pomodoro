<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_40">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_eyebrow"
            android:textAppearance="@style/Clock.Eyebrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/settings_title"
            android:textAppearance="@style/Clock.ScreenTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:lineSpacingExtra="3dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/clock_on_surface_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/settings_behavior_section"
            android:textAppearance="@style/Clock.FieldLabel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingVertical="@dimen/space_8">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/reduce_motion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/settings_reduce_motion"
                android:textColor="@color/clock_on_surface"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/clock_outline_soft" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/keep_screen_on"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:text="@string/settings_keep_screen_on"
                android:textColor="@color/clock_on_surface"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:background="@drawable/bg_note"
            android:lineSpacingExtra="3dp"
            android:padding="@dimen/space_16"
            android:text="@string/timer_semantics_note"
            android:textColor="@color/clock_on_surface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:text="@string/settings_data_section"
            android:textAppearance="@style/Clock.FieldLabel" />

        <Button
            android:id="@+id/export_backup"
            style="@style/Clock.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/settings_export" />

        <Button
            android:id="@+id/export_csv"
            style="@style/Clock.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/settings_export_csv" />

        <Button
            android:id="@+id/import_backup"
            style="@style/Clock.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/settings_import" />
    </LinearLayout>
</ScrollView>
