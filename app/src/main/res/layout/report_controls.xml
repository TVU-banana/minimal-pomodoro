<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">
    <RadioGroup
        android:id="@+id/report_period"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_report_segment_track"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">
        <RadioButton android:id="@+id/report_year" style="@style/Clock.ReportSegmentOption"
            android:text="@string/report_year" />
        <RadioButton android:id="@+id/report_week" style="@style/Clock.ReportSegmentOption"
            android:text="@string/report_week" />
        <RadioButton android:id="@+id/report_day" style="@style/Clock.ReportSegmentOption"
            android:checked="true" android:text="@string/report_day" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/report_range_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/report_previous_range"
            android:padding="14dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/clock_on_surface" />

        <TextView
            android:id="@+id/report_range_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/clock_on_surface"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/report_range_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/report_next_range"
            android:padding="14dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/clock_on_surface" />
    </LinearLayout>

    <TextView
        android:id="@+id/report_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/clock_on_surface"
        android:textSize="24sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/report_export_poster"
        style="@style/Clock.SecondaryButton"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/report_export_poster"
        android:visibility="gone" />

    <TextView
        android:id="@+id/report_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:background="@drawable/bg_note"
        android:gravity="start"
        android:lineSpacingExtra="3dp"
        android:padding="@dimen/space_20"
        android:text="@string/report_empty"
        android:textColor="@color/clock_on_surface"
        android:textSize="15sp" />

</LinearLayout>
