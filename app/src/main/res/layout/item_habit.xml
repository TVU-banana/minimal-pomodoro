<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="64dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="63dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingVertical="8dp">
        <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/habit_check"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp" app:srcCompat="@drawable/ic_habit_unchecked" />
            <TextView android:id="@+id/habit_remaining"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:textSize="14sp"
                android:importantForAccessibility="no" android:clickable="false"
                android:textColor="@color/clock_on_surface_muted" />
        </FrameLayout>
        <LinearLayout android:id="@+id/habit_edit"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:minHeight="48dp"
            android:gravity="center_vertical" android:orientation="vertical"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackground" android:focusable="true">
            <LinearLayout android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView android:id="@+id/habit_name"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_weight="1" android:fontFamily="sans-serif-medium"
                    android:textSize="17sp" android:gravity="start"
                    android:textAlignment="viewStart" android:maxLines="2" android:ellipsize="end"
                    android:textColor="@color/clock_on_surface" />
            </LinearLayout>
            <TextView android:id="@+id/habit_note"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="start"
                android:textAlignment="viewStart" android:textSize="13sp"
                android:textColor="@color/clock_on_surface_muted" android:visibility="gone" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/habit_more"
            android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_more" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/clock_outline_soft" />
</LinearLayout>
