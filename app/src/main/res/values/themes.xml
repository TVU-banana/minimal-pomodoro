<resources>
    <style name="Theme.Clock" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/clock_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/clock_primary</item>
        <item name="colorPrimary">@color/clock_primary</item>
        <item name="colorAccent">@color/clock_primary</item>
        <item name="colorControlNormal">@color/clock_on_surface_muted</item>
        <item name="colorControlActivated">@color/clock_primary</item>
        <item name="android:colorButtonNormal">@color/clock_surface_raised</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Clock.BottomNavButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Clock.ScreenTitle" parent="TextAppearance.AppCompat.Display1">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/clock_on_surface</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Clock.Eyebrow" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/clock_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Clock.FieldLabel" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/clock_on_surface_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
    <style name="Clock.Input" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/clock_on_surface</item>
        <item name="android:textColorHint">@color/clock_disabled</item>
        <item name="android:textSize">16sp</item>
        <item name="android:selectAllOnFocus">true</item>
    </style>
    <style name="Clock.PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/clock_on_primary</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Clock.SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/clock_on_surface</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
