<resources>
    <style name="Theme.Clock.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorBackground">@color/clock_background</item>
        <item name="android:windowBackground">@color/clock_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/clock_primary</item>
        <item name="colorPrimary">@color/clock_primary</item>
        <item name="colorAccent">@color/clock_primary</item>
        <item name="colorControlNormal">@color/clock_on_surface_muted</item>
        <item name="colorControlActivated">@color/clock_primary</item>
        <item name="android:colorButtonNormal">@color/clock_surface_raised</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Clock" parent="Theme.Clock.Base" />
    <style name="Clock.BottomNavButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:drawablePadding">-6dp</item>
        <item name="android:drawableTint">@color/nav_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center_horizontal|bottom</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Clock.BottomNavItem" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
    <style name="Clock.ScreenTitle" parent="TextAppearance.AppCompat.Display1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/clock_on_surface</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="Clock.Eyebrow" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/clock_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Clock.FieldLabel" parent="TextAppearance.AppCompat.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/clock_on_surface_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
    <style name="Clock.Input" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/clock_on_surface</item>
        <item name="android:textColorHint">@color/clock_on_surface_muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:selectAllOnFocus">true</item>
    </style>
    <style name="Clock.PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Clock.SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/clock_on_surface</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Clock.SegmentOption" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/bg_segment_option</item>
        <item name="android:button">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Clock.ReportSegmentOption" parent="Clock.SegmentOption">
        <item name="android:paddingVertical">0dp</item>
        <item name="android:background">@drawable/bg_report_segment_option</item>
    </style>
    <style name="Clock.SettingsRow" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/clock_on_surface</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="Clock.HabitPopupTheme" parent="ThemeOverlay.AppCompat">
        <item name="popupMenuStyle">@style/Clock.HabitPopupMenu</item>
    </style>
    <style name="Clock.HabitPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_habit_popup</item>
    </style>
</resources>
