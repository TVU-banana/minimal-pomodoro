<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="5dp">
    <ripple android:color="@color/clock_ripple">
        <item>
            <shape android:shape="oval">
                <solid android:color="@color/clock_toolbar_glass" />
                <stroke
                    android:width="1dp"
                    android:color="@color/clock_on_surface_muted" />
            </shape>
        </item>
        <item android:id="@android:id/mask">
            <shape android:shape="oval">
                <solid android:color="#FFFFFFFF" />
            </shape>
        </item>
    </ripple>
</inset>
