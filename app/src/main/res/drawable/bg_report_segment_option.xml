<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/clock_ripple">
    <item>
        <inset
            android:insetTop="6dp"
            android:insetBottom="6dp">
            <selector>
                <item android:state_checked="true">
                    <shape>
                        <solid android:color="@color/clock_surface_raised" />
                        <stroke android:width="1dp" android:color="@color/clock_outline_soft" />
                        <corners android:radius="18dp" />
                    </shape>
                </item>
                <item>
                    <shape>
                        <solid android:color="@android:color/transparent" />
                    </shape>
                </item>
            </selector>
        </inset>
    </item>
</ripple>
