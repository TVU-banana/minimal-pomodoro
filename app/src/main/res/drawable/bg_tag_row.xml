<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/clock_primary_soft" />
            <stroke android:width="1.5dp" android:color="@color/clock_primary" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/clock_surface_raised" />
            <stroke android:width="1dp" android:color="@color/clock_outline_soft" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
