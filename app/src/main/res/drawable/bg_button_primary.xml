<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/clock_ripple">
    <item><selector>
        <item android:state_enabled="false"><shape><solid android:color="@color/clock_surface" /><corners android:radius="8dp" /></shape></item>
        <item android:state_pressed="true"><shape><solid android:color="@color/clock_primary_pressed" /><corners android:radius="8dp" /></shape></item>
        <item><shape><solid android:color="@color/clock_primary" /><corners android:radius="8dp" /></shape></item>
    </selector></item>
</ripple>
